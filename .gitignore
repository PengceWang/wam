# Environments and caches
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Weights. The stage-1a checkpoint alone is 1.6GB.
checkpoints/
*.pt
*.ckpt
*.safetensors

# Anything produced by a run
logs/
dryrun/
runs/
wandb/
play_recordings/
*.mp4
*.npy

# Datasets live outside the repo: the 6xx contractor subset is 175GB and the
# window index is 150k rows. Both are reproducible -- see docs/measurements.md.
#
# The leading slash matters. Without it this pattern matches a directory named
# `data` at ANY depth, which silently swallowed the whole `wam/data/` package --
# it was never committed, and every entry point imports it. Anchor it to the
# repo root so only the dataset directory is ignored.
/data/
*.mdb
*_index_*.npz

# Credentials never belong here. wandb writes to ~/.netrc.
.netrc
*.key
.env
